# Build intermediates, kept out of Mod/: the Workshop uploader sends that folder as it is,
# with no filtering, so a publicised Assembly-CSharp.dll left inside it would be redistributed.
.build/
Source/obj/
Source/bin/

# Claude Code session worktrees and local settings. A session creates its worktree in the
# current directory, so sometimes inside this one; each is a full copy of the repository.
# Until this mod was detached, only the machine-wide ignore rule covered this - a property of
# the machine, not of the repository, which is why it is written here now.
.claude/

# Windows shortcuts dropped in the mod folder, never content.
*.lnk

# Pickle writes two files no run needs afterwards, and they are enormous: report.html is the
# whole run inlined as base64, around 80 MB, and messages.ndjson around 9 MB. The evidence worth
# keeping is junit.xml, summary.json, summary.md, Player.log and the screenshots - which is what
# every earlier run in this folder kept. One 2026-09-23 commit added the other two before this
# rule existed; their blobs are in the history and only a rewrite would take them out.
Tests/Pickle/evidence/**/report.html
Tests/Pickle/evidence/**/messages.ndjson
